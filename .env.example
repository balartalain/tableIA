# Copiar este archivo a ".env" y completar los valores.
# ".env" NO se versiona (ver .gitignore); este archivo de ejemplo sí.

# --- Django core ---

# Clave secreta de Django. En producción es OBLIGATORIO generar una propia
# y mantenerla en secreto (no usar el valor por defecto de settings.py).
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-unica-en-produccion

# En producción SIEMPRE debe ser False.
DEBUG=True

# En producción es obligatorio listar los dominios/IPs que sirven la app,
# separados por comas. Ejemplo: reportes.uapa.edu.do,www.reportes.uapa.edu.do
ALLOWED_HOSTS=localhost,127.0.0.1

# Prefijo de ruta bajo el que corre la app en producción, sin slash final
# (ej. si Apache define Alias /sheets-reports -> esta app, usar /sheets-reports).
# Vacío en desarrollo, donde la app corre en la raíz "/".
REPORT_PATH=

# --- Base de datos ---

# Si no se define, la app usa SQLite local (db.sqlite3), pensado solo para
# desarrollo. En producción definir una base de datos real, por ejemplo Postgres:
#   DATABASE_URL=postgres://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB
DATABASE_URL=

# --- Google OAuth (conectar la cuenta del usuario y Google Picker) ---

# Cliente OAuth 2.0 de Google Cloud, de tipo «Web». Al conectar su cuenta, el usuario elige la
# hoja directamente de su Drive con el selector nativo de Google (app google_auth).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# «Authorized redirect URI» del cliente. Debe terminar en /auth/google/callback/.
# Vacío: se arma con el dominio de cada petición (cómodo en desarrollo).
GOOGLE_OAUTH_REDIRECT_URI=

# Para el Google Picker: la API key (Picker API habilitada) y el número de proyecto de Google Cloud.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# Clave con la que se cifran los tokens de Google guardados. Vacía: se deriva de SECRET_KEY
# (cambiarla obligaría a reconectar la cuenta).
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Gemini ---

# API key de Gemini, usada para generar la especificación JSON de un widget a partir de un
# prompt. La IA nunca genera código ni toca los datos.
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-2.5-flash

# Archivo donde se registra cada spec generado por IA junto a su prompt (auditoría).
AI_AUDIT_LOG_FILE=

# --- Envío de correos ---

# Zona horaria de la hora de envío que elige el usuario en cada tablero.
CAMPAIGN_TIME_ZONE=America/Santo_Domingo

# Clave con la que se cifran las contraseñas de aplicación de los remitentes. Si se deja
# vacía se deriva de SECRET_KEY (cambiar SECRET_KEY obligaría a escribirlas de nuevo).
# Generar una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENCRYPTION_KEY=

# Servidor SMTP de los remitentes (por defecto, Gmail).
CAMPAIGN_SMTP_HOST=smtp.gmail.com
CAMPAIGN_SMTP_PORT=587

# Solo en local, para probar sin enviar nada: cada correo se imprime en la terminal en vez
# de salir por SMTP (ver docs/configuracion_correos.md). No usar en el servidor.
# CAMPAIGN_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Los envíos los arranca el crontab del servidor (ver docs/configuracion_correos.md), por
# ejemplo cada 5 minutos:
#   */5 * * * * cd /ruta/TableIA && venv/bin/python manage.py send_campaign_emails
