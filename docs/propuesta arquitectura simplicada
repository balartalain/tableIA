class BaseWidget:
    type_key: str
    style_schema: List[Dict[str, Any]] = []

    def process_query(self, df, fields: WidgetFields):
        raise NotImplementedError

    def render(self, df, form_data: dict) -> dict:
        form = WidgetForm.from_dict(form_data)
        data = self.process_query(df, form.fields)
        return {
            "render_data": data,
            "widget_form": form.to_dict()
        }

class BarChartWidget(BaseWidget):
    type_key = "bar_chart"
    
    # Backend-driven style schema
    style_schema = [
        {"key": "title", "label": "Título", "ui": "text", "default": "Gráfico de Barras"},
        {
            "key": "color_scheme", 
            "label": "Paleta de Colores", 
            "ui": "select", 
            "options": [
                {"label": "Por defecto", "value": "default"},
                {"label": "Océano", "value": "ocean"}
            ],
            "default": "default"
        },
        {"key": "stacked", "label": "Apilar Barras", "ui": "checkbox", "default": False}
    ]

    def process_query(self, df, fields: WidgetFields):
        # Procesamiento directo con Pandas / ORM sin usar la antigua clase Metrics
        if not fields.metrics:
            return df

        # Construcción directa de la agregación a partir de la lista de diccionarios de métricas
        agg_map = {m.get("alias", f"{m['agg']}_{m['field']}"): (m["field"], m["agg"]) for m in fields.metrics}
        
        if fields.dimensions:
            return df.groupby(fields.dimensions).agg(**agg_map).reset_index()
        return df.agg(**agg_map)
        
        
